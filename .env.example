# Copy to .env (git ignores it) and fill in. Never commit the real key.

# ElevenLabs: sound effects and music for the audio list in docs/ASSETS.md.
# Get a key at elevenlabs.io → profile → API keys. A paid plan is needed for commercial use.
ELEVENLABS_API_KEY=

# OpenRouter: Gemini listens to generated sounds and says whether they match their prompt (audio critic).
# Calls are pinned to the Google Vertex provider (no fallback), so they use Vertex credits.
# Get a key at openrouter.ai → Keys.
OPENROUTER_API_KEY=
